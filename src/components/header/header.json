      },
      "button": {
        "primary": "rounded-xl bg-gradient-to-r from-primary to-primary-dark px-5 py-2.5 text-sm font-medium text-white shadow-md hover:opacity-90 transition",
        "secondary": "rounded-xl bg-gradient-to-r from-primary/10 to-secondary/10 px-4 py-2 text-sm font-medium text-gray-800 hover:from-primary/20 hover:to-secondary/20 transition"
      }
    },
    "animations": {
      "header": {
        "initial": { "y": -100 },
        "animate": { "y": 0 },
        "transition": { "type": "spring", "stiffness": 100, "damping": 20 }
      },
      "logo": {
        "whileHover": { "scale": 1.05, "rotateY": 5 },
        "transition": { "type": "spring", "stiffness": 400, "damping": 10 }
      },
      "dropdown": {
        "initial": { "opacity": 0, "y": 15, "scale": 0.95 },
        "animate": { "opacity": 1, "y": 0, "scale": 1 },
        "exit": { "opacity": 0, "y": 15, "scale": 0.95 },
        "transition": { "duration": 0.2 }
      }
    }
